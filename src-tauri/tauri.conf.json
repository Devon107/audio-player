{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vinilo",
  "version": "0.1.0",
  "identifier": "com.audioplayer.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "title": "Vinilo - Music Player",
        "width": 1100,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/covers/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "homepage": "https://github.com/Devon107/audio-player",
    "category": "Music",
    "shortDescription": "Reproductor de audio MP3 con biblioteca, playlists y ecualizador",
    "longDescription": "Vinilo es un reproductor de audio MP3 multiplataforma: biblioteca musical con búsqueda y filtros por artista/álbum/género, playlists, cola de reproducción con aleatorio y repetición, ecualizador de 10 bandas, y controles nativos de medios del sistema operativo.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
